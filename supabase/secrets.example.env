# AH Student Hub — inert reference only.
#
# This file is safe to commit because every value below is a placeholder. Copy it
# outside the repository, replace values there, and upload that private copy with
# `supabase secrets set --env-file <private-file>`. Never commit a populated copy.

# Browser origins allowed to call Edge Functions (comma separated, no trailing slash).
ALLOWED_ORIGINS=https://your-production-domain.example
# Set false in every production deployment. Local development should use staging.
ALLOW_LOCALHOST=false

# Google Sheets read-only mirror. Store the service-account JSON only in the
# deployment secret manager; base64 encode it there, never in source control.
SHEET_ID=REPLACE_WITH_SHEET_ID
SHEET_TAB=Online Applications
ADMIN_TAB=Admin Registrations
GOOGLE_SERVICE_ACCOUNT_B64=REPLACE_WITH_BASE64_SERVICE_ACCOUNT_JSON

# Key-encryption material for payment-provider configuration. Generate and store
# this only in the managed secret store. Rotating it requires re-encrypting or
# re-entering all protected provider values.
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_48_BYTE_BASE64_SECRET

# Payment fallback. Use managed secrets for real bank and provider values.
PAY_MODE=manual
BANK_NAME=REPLACE_WITH_BANK_NAME
BANK_ACCOUNT_NAME=REPLACE_WITH_ACCOUNT_NAME
BANK_ACCOUNT_NUMBER=REPLACE_WITH_ACCOUNT_NUMBER
# MONNIFY_API_KEY=REPLACE_WITH_SECRET
# MONNIFY_CONTRACT_CODE=REPLACE_WITH_CONTRACT_CODE
# MONNIFY_SECRET_KEY=REPLACE_WITH_SECRET
# MONNIFY_BASE_URL=https://sandbox.monnify.example

# Optional communication providers.
# RESEND_API_KEY=REPLACE_WITH_SECRET
# RESEND_FROM_EMAIL=no-reply@your-domain.example
# SMS_PROVIDER_URL=https://provider.example
# SMS_PROVIDER_TOKEN=REPLACE_WITH_SECRET
# WHATSAPP_PROVIDER_URL=https://provider.example
# WHATSAPP_PROVIDER_TOKEN=REPLACE_WITH_SECRET
