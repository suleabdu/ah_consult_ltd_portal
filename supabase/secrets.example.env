# AH STUDENT HUB - Supabase Edge Function secrets. NEVER commit real values.
# Set values in a private file with:
#   supabase secrets set --env-file <your-private-copy>
# Or use Dashboard > Edge Functions > Secrets.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are supplied automatically.

# --- Required in production: browser origins permitted to call Edge Functions
# Comma-separated, without a trailing slash. "*" is never the default.
ALLOWED_ORIGINS=YOUR_HTTPS_ORIGIN
# Set to false in production after local testing is complete.
ALLOW_LOCALHOST=true

# --- Google Sheets read-only mirror
SHEET_ID=YOUR_GOOGLE_SHEET_ID
SHEET_TAB=YOUR_GOOGLE_SHEET_TAB
ADMIN_TAB=YOUR_GOOGLE_ADMIN_TAB
# Base64-encode the original service-account JSON file itself; never paste a token.
GOOGLE_SERVICE_ACCOUNT_B64=YOUR_BASE64_ENCODED_SERVICE_ACCOUNT_JSON

# --- Encrypts provider credentials saved from the Admin dashboard
# Generate once, keep it in the secret store, and do not rotate it casually.
SETTINGS_ENCRYPTION_KEY=YOUR_STABLE_HIGH_ENTROPY_ENCRYPTION_KEY

# --- Optional manual-payment fallback when no provider is configured in Admin
PAY_MODE=manual
BANK_NAME=YOUR_BANK_NAME
BANK_ACCOUNT_NAME=YOUR_BANK_ACCOUNT_NAME
BANK_ACCOUNT_NUMBER=YOUR_BANK_ACCOUNT_NUMBER
# MONNIFY_API_KEY=YOUR_MONNIFY_API_KEY
# MONNIFY_CONTRACT_CODE=YOUR_MONNIFY_CONTRACT_CODE
# MONNIFY_SECRET_KEY=YOUR_MONNIFY_SECRET_KEY
# MONNIFY_BASE_URL=https://sandbox.monnify.com

# --- Optional communication worker
# RESEND_API_KEY=YOUR_RESEND_API_KEY
# RESEND_FROM_EMAIL=YOUR_VERIFIED_SENDER_EMAIL
# SMS_PROVIDER_URL=YOUR_SMS_PROVIDER_URL
# SMS_PROVIDER_TOKEN=YOUR_SMS_PROVIDER_TOKEN
# Meta WhatsApp Cloud API credentials are encrypted via Admin Dashboard settings.
