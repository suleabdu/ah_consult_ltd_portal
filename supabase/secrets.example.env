GOOGLE_SERVICE_ACCOUNT_JSON=<SET_IN_SUPABASE_SECRETS_ONLY>
GOOGLE_SHEET_ID=<YOUR_SHEET_ID>
ALLOWED_ORIGINS=https://your-production-domain.example
