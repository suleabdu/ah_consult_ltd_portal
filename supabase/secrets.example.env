# AH STUDENT HUB - Supabase Edge Function secrets.   NEVER commit real values.
# Set with:  supabase secrets set --env-file <your-private-copy>   (or Dashboard > Edge Functions > Secrets)
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.

# --- REQUIRED in production: browser origins allowed to call the functions (comma-separated, no trailing slash)
# If unset, ONLY localhost/private-network origins work. "*" is never the default; set it explicitly only for experiments.
ALLOWED_ORIGINS=https://ahconsultportal.vercel.app, https://localhost:3000
# Set to false on production once local testing is finished.
ALLOW_LOCALHOST=true

# --- Google Sheets read-only mirror
SHEET_ID=1D5fB2_23elEx5UWWZooyoxDUzvaVu7VBStdlFA21_P8
SHEET_TAB=Online Applications
ADMIN_TAB=Admin Registrations
GOOGLE_SERVICE_ACCOUNT_

# --- Encrypts payment-provider secrets saved from the Admin dashboard (generate once, keep it safe, never rotate casually)
SETTINGS_ENCRYPTION_KEY=KuQwLWPe0OOmxurtrldLw2R+bBoFs7N0cHqsWg5fssQ=

# --- Optional payment fallback when no provider is configured in the dashboard
PAY_MODE=manual
BANK_NAME=YOUR_BANK
BANK_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
BANK_ACCOUNT_NUMBER=YOUR_ACCOUNT_NUMBER
