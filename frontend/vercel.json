{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/apply",
      "destination": "/apply.html"
    },
    {
      "source": "/student-login",
      "destination": "/student-login.html"
    },
    {
      "source": "/staff-login",
      "destination": "/staff-login.html"
    },
    {
      "source": "/admin-register",
      "destination": "/admin-register.html"
    },
    {
      "source": "/tutor",
      "destination": "/tutor.html"
    },
    {
      "source": "/admin-dashboard",
      "destination": "/admin-dashboard.html"
    },
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/payment-success",
      "destination": "/payment-success.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/forgot-password.html"
    },
    {
      "source": "/verify-document",
      "destination": "/verify-document.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https://lh3.googleusercontent.com https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src blob: https://www.google.com https://www.openstreetmap.org; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admission-letter",
      "destination": "/apply",
      "permanent": false
    },
    {
      "source": "/admission-letter.html",
      "destination": "/apply",
      "permanent": false
    },
    {
      "source": "/deferment-letter",
      "destination": "/portal",
      "permanent": false
    },
    {
      "source": "/deferment-letter.html",
      "destination": "/portal",
      "permanent": false
    },
    {
      "source": "/payment-receipt",
      "destination": "/apply",
      "permanent": false
    },
    {
      "source": "/payment-receipt.html",
      "destination": "/apply",
      "permanent": false
    },
    {
      "source": "/result",
      "destination": "/portal",
      "permanent": false
    },
    {
      "source": "/result.html",
      "destination": "/portal",
      "permanent": false
    },
    {
      "source": "/transcripts",
      "destination": "/portal",
      "permanent": false
    },
    {
      "source": "/transcripts.html",
      "destination": "/portal",
      "permanent": false
    },
    {
      "source": "/transcrpts",
      "destination": "/portal",
      "permanent": false
    },
    {
      "source": "/transcrpts.html",
      "destination": "/portal",
      "permanent": false
    }
  ]
}
